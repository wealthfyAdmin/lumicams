# =============================================================================
# Lumicams / Aegis-Eye — Backend environment (PRODUCTION TEMPLATE)
# Copy to `.env` and set secrets. Never commit `.env`.
# =============================================================================

# --- Core ---
ENVIRONMENT=production
# AEGIS_ENV=production
APP_VERSION=1.0.0

# PostgreSQL (required)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aegis_eye

# JWT — use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-long-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# First-run seed (only when users table is empty)
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
DEFAULT_ADMIN_PASSWORD=ChangeMeImmediately123!

# Browser origins for CORS (exact, no trailing slash). Comma-separated.
ALLOWED_ORIGINS=https://app.yourcompany.com

# Optional: Host header allowlist when behind nginx/caddy (comma-separated).
# TRUSTED_HOSTS=app.yourcompany.com,api.internal

# API docs: off by default in production (set true for internal debugging only).
# DOCS_ENABLED=false

# WebSocket: require JWT query param (recommended in production).
# WS_REQUIRE_TOKEN=true

# Snapshots on disk (relative to backend working directory)
SNAPSHOT_DIR=snapshots

# =============================================================================
# Vision-language verification (smart second-stage on alerts)
# =============================================================================
VLM_ENABLED=true
# --- Local Ollama (vision model, e.g. ollama pull llava) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=llava
# OLLAMA_API_KEY=   # optional; Ollama often ignores this
# Only VLM "confirmed" passes if JSON confidence >= this (use 70 for 70%, or 0.7)
VLM_MIN_CONFIDENCE=70
# --- Or cloud OpenAI: leave OLLAMA_BASE_URL unset and set ---
# OPENAI_API_KEY=
# VLM_MODEL=gpt-4o-mini
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# =============================================================================
# Detection models (place .pt files under backend/models/ or set absolute paths)
# =============================================================================
# Default detector: YOLO11 nano (downloads on first run). Override with a local .pt path if needed.
YOLO_FIRE_MODEL=yolo11n.pt
PERSON_DETECT_MODEL=yolo11n.pt
PEOPLE_TRACKER_BACKEND=bytetrack

# PPE
YOLO_PPE_MODEL=models/ppe.pt
# YOLO_PPE_AUX_MODEL=models/ppe_aux.pt
PPE_CONF_THRESHOLD=0.45
PPE_DEFAULT_ITEMS=helmet,vest

# Weapon (optional). Place a .pt here, e.g. download:
#   https://huggingface.co/Hadi959/weapon-detection-yolov8/resolve/main/best.pt → models/weapon.pt
# YOLO_WEAPON_MODEL=models/weapon.pt
WEAPON_CONF_THRESHOLD=0.45
# If no weapon .pt is found: use these COCO classes on PERSON_DETECT_MODEL (no firearm in COCO).
WEAPON_COCO_KNIFE_FALLBACK=true
WEAPON_COCO_FALLBACK_CLASS_NAMES=knife,baseball bat
# Crop weapon alert snapshots to the detection region when it is small in frame (red boxes always drawn).
# WEAPON_SNAPSHOT_CROP=true
# If the .pt only has pistol/knife, long thin boxes are labeled "rifle" (tune aspect threshold).
# WEAPON_GEOM_REFINE=true
# WEAPON_RIFLE_MIN_ASPECT=2.05
# WEAPON_MATCH_ALL_CLASSES=false

# Face pipeline
FACE_RECOGNITION_ENABLED=false
FACE_MATCH_THRESHOLD=0.48
FACE_COOLDOWN_SECONDS=45

# =============================================================================
# Inference tuning — production-friendly defaults (adjust per site)
# =============================================================================
INFER_EVERY_N_FRAMES=2
ALERT_COOLDOWN_SECONDS=10
FIRE_CONF_THRESHOLD=0.45
FIRE_ALERT_MIN_INTERVAL_SECONDS=180
FIRE_CONSECUTIVE_FRAMES=3

# Person / crowd — reduce chair false positives & duplicate overcrowd alerts
FOOTFALL_PERSON_CONF=0.42
PERSON_COUNT_CONF_MIN=0.42
PERSON_MIN_BOX_AREA_NORM=0.00115
PERSON_MIN_BOX_HEIGHT_NORM=0.052
PERSON_MIN_W_OVER_H=0.2
PERSON_MAX_BOX_ASPECT=2.2

CROWD_LIMIT_ALERT_COOLDOWN_SECONDS=45
CROWD_OVERCROWD_ALERT_MIN_INTERVAL_SECONDS=180
CROWD_OVER_LIMIT_CONSEC_FRAMES=4
CROWD_LIMIT_COUNT_MODE=auto

# Fall / pose
FALL_CONSECUTIVE_FRAMES=5
POSE_DETECTION_CONF=0.5

# Re-ID samples for Forensics tab
PERSON_REID_SAMPLE_EVERY_FRAMES=45
PERSON_REID_TRACK_COOLDOWN=8.0

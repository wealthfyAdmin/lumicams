# =============================================================================
# Lumicams — Frontend (Next.js)
# Copy to `.env.local` for local dev. In Docker, pass env at build/run (see Dockerfile).
# =============================================================================

# Backend used by Next.js rewrites (server-side). In Docker stack: http://api:8000
BACKEND_URL=https://r5flwv750aokon-8000.proxy.runpod.net

# Browser API base (axios). Same-origin dev: /api (proxied). Production: full URL to API.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_API_URL=/api

# Optional: explicit WebSocket URL (otherwise derived from NEXT_PUBLIC_API_URL or same host)
# NEXT_PUBLIC_WS_URL=wss://app.yourcompany.com/ws/alerts

NODE_ENV=development
